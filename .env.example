# ============================================
# Pakistani WhatsApp Bot - Environment Variables
# ============================================

# Supabase Configuration (Free Tier)
# Get from: https://supabase.com -> New Project -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenRouter Configuration (Free Tier - 50 requests/day)
# Get from: https://openrouter.ai -> Sign up -> API Keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# OR Google Gemini Configuration (Free Tier - 60 requests/min)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# AI Provider Selection
# Options: "openrouter" or "gemini"
AI_PROVIDER=openrouter

# OpenRouter Model (Free tier options)
# Options: meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat, qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Bot Configuration
BOT_NAME=ShopBot
DEFAULT_LANGUAGE=roman_urdu

# Rate Limiting (OpenRouter free tier)
MAX_AI_CALLS_PER_DAY=50

# Payment Configuration (Manual for MVP)
# These will be set per merchant in the database
DEFAULT_EASYPAYSA_NUMBER=03XXXXXXXXX
DEFAULT_JAZZCASH_NUMBER=03XXXXXXXXX

# Render.com Configuration
PORT=3000
NODE_ENV=production

# Baileys Auth State Storage
# "file" = local filesystem (for local dev)
# "supabase" = database storage (for Render.com deployment)
AUTH_STORAGE_TYPE=file
